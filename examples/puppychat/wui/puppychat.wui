<Switch>
  <Case path="/*" title="PuppyChat">
    <If test={state.user_name == ""}>
      <VStack padding=16 spacing=12 width=360>
        <Text value="Login to PuppyChat" />
        <Form action="/login" method="post" spacing=8>
          <VStack spacing=8>
            <TextInput name="name" placeholder="Username" />
            <TextInput name="password" type="password" placeholder="Password" />
            <Button text="Login" />
          </VStack>
        </Form>
        <Link href="/register" text="Register" />
      </VStack>
    </If>
    <Else>
      <HStack class={state.shell_class} spacing=0 grow=1>
        <VStack class="puppychat-sidebar" width=260 minWidth=200 maxWidth=420 padding=12 spacing=10 backgroundColor="#f6f5f2" border="1px solid #e1ded7" hresize=true overflow="auto">
          <Text value="PuppyChat" />
          <HStack spacing=6>
            <Text value="Channels" grow=1 />
            <Form action="/chat/channels/new" method="post">
              <Button text="Add" />
            </Form>
          </HStack>
          <VStack spacing=4>
            <For each={state.channels} itemAs="channel">
              <Link href={channel.href} text={channel.display_name} />
            </For>
          </VStack>
          <Text value="Direct Messages" />
          <VStack spacing=4>
            <For each={state.directs} itemAs="dm">
              <HStack spacing=6>
                <Text value={dm.online ? "●" : "○"} />
                <Link href={dm.href} text={dm.display_name} />
              </HStack>
            </For>
          </VStack>
          <VStack grow=1 />
        </VStack>
        <VStack class="puppychat-main" grow=1 padding=12 spacing=10>
          <HStack class="puppychat-header" spacing=8>
            <Link class="puppychat-back" href="/" text="← Channels" />
            <Text value={state.active_name} />
            <If test={state.active_kind != "" && !state.call_active}>
              <Form action="/chat/call/audio" method="post"><Button text="Audio Call" /></Form>
              <Form action="/chat/call/video" method="post"><Button text="Video Call" /></Form>
            </If>
            <If test={state.call_active}>
              <Form action="/chat/call/end" method="post"><Button text="End Call" /></Form>
            </If>
            <VStack class="puppychat-user-menu" grow=1>
              <Form action="/chat/user-menu/toggle" method="post">
                <Button text={state.user_name} />
              </Form>
              <If test={state.show_user_menu}>
                <VStack
                  class="puppychat-user-menu-dropdown"
                  padding=8
                  spacing=4
                  backgroundColor="#ffffff"
                  border="1px solid #d9d9d9"
                >
                  <Form action="/logout" method="post"><Button text="Logout" /></Form>
                </VStack>
              </If>
            </VStack>
          </HStack>
          <If test={state.call_active && state.call_room != ""}>
            <VStack spacing=8 padding=8 border="1px solid #d8d8d8">
              <Text value={state.call_with_video ? "Video call in progress" : "Audio call in progress"} />
              <If test={state.call_with_video}>
                <HStack spacing=8 wrap=true>
                  <VStack spacing=4 grow=1>
                    <Text value="You" />
                    <Video
                      room={state.call_room}
                      local=true
                      muted=true
                      autoplay=true
                      controls=false
                      width=240
                      height=160
                    />
                  </VStack>
                  <VStack spacing=4 grow=1>
                    <Text value="Remote" />
                    <Video
                      room={state.call_room}
                      local=false
                      muted=true
                      autoplay=true
                      controls=false
                      width=240
                      height=160
                    />
                  </VStack>
                </HStack>
                <HStack class="puppychat-call-controls" spacing=8>
                  <Audio room={state.call_room} local=true muted=true autoplay=true controls=false />
                  <Audio room={state.call_room} local=false muted=false autoplay=true controls=true />
                  <Text value="If remote audio stays muted, press play on the audio control." />
                </HStack>
              </If>
              <If test={!state.call_with_video}>
                <HStack class="puppychat-call-controls" spacing=8>
                  <Audio room={state.call_room} local=true muted=true autoplay=true controls=false />
                  <Audio room={state.call_room} local=false muted=false autoplay=true controls=true />
                  <Text value="Audio connected when another participant joins this room." />
                </HStack>
              </If>
            </VStack>
          </If>
          <VStack class="puppychat-messages" partial={state.message_partial_addr} spacing=6 grow=1 overflow="scroll">
            <If test={state.active_kind == "channel"}>
              <For each={state.channels} itemAs="channel">
                <If test={channel.id == state.active_id}>
                  <For each={channel.messages} itemAs="msg">
                    <VStack class="puppychat-message" spacing=2 padding=6 border="1px solid #e6e6e6">
                      <HStack spacing=8>
                        <Text value={msg.author} fontWeight="bold" />
                        <Text value={msg.time} />
                        <If test={msg.author == state.user_name}>
                          <VStack class="puppychat-message-actions">
                            <Form action="/chat/messages/menu" method="post">
                              <TextInput name="id" type="hidden" value={msg.id} />
                              <Button class="puppychat-more-actions" text="…" />
                            </Form>
                            <If test={state.message_menu_id == msg.id}>
                              <VStack
                                class="puppychat-message-menu"
                                padding=6
                                spacing=4
                                backgroundColor="#ffffff"
                                border="1px solid #d9d9d9"
                              >
                                <Form action="/chat/messages/edit/open" method="post">
                                  <TextInput name="id" type="hidden" value={msg.id} />
                                  <Button text="Edit" />
                                </Form>
                                <Form action="/chat/messages/delete" method="post">
                                  <TextInput name="id" type="hidden" value={msg.id} />
                                  <Button text="Delete" color="#b42318" />
                                </Form>
                              </VStack>
                            </If>
                          </VStack>
                        </If>
                      </HStack>
                      <If test={state.editing_message_id == msg.id}>
                        <Form action="/chat/messages/edit" method="post">
                          <TextInput name="id" type="hidden" value={msg.id} />
                          <HStack spacing=6>
                            <TextInput name="body" value={msg.body} grow=1 />
                            <Button text="Save" />
                          </HStack>
                        </Form>
                        <Form action="/chat/messages/edit/cancel" method="post">
                          <Button text="Cancel" />
                        </Form>
                      </If>
                      <Else>
                        <If test={msg.body != ""}>
                          <Text value={msg.body} />
                        </If>
                        <If test={msg.image_url != ""}>
                          <Image
                            src={msg.image_url}
                            href={msg.image_href}
                            alt="picture"
                            objectFit="contain"
                            maxWidth=320
                            maxHeight=220
                            cursor="pointer"
                          />
                        </If>
                      </Else>
                    </VStack>
                  </For>
                </If>
              </For>
            </If>
            <If test={state.active_kind == "dm"}>
              <For each={state.directs} itemAs="dm">
                <If test={dm.id == state.active_id}>
                  <For each={dm.messages} itemAs="msg">
                    <VStack class="puppychat-message" spacing=2 padding=6 border="1px solid #e6e6e6">
                      <HStack spacing=8>
                        <Text value={msg.author} fontWeight="bold" />
                        <Text value={msg.time} />
                        <If test={msg.author == state.user_name}>
                          <VStack class="puppychat-message-actions">
                            <Form action="/chat/messages/menu" method="post">
                              <TextInput name="id" type="hidden" value={msg.id} />
                              <Button class="puppychat-more-actions" text="…" />
                            </Form>
                            <If test={state.message_menu_id == msg.id}>
                              <VStack
                                class="puppychat-message-menu"
                                padding=6
                                spacing=4
                                backgroundColor="#ffffff"
                                border="1px solid #d9d9d9"
                              >
                                <Form action="/chat/messages/edit/open" method="post">
                                  <TextInput name="id" type="hidden" value={msg.id} />
                                  <Button text="Edit" />
                                </Form>
                                <Form action="/chat/messages/delete" method="post">
                                  <TextInput name="id" type="hidden" value={msg.id} />
                                  <Button text="Delete" color="#b42318" />
                                </Form>
                              </VStack>
                            </If>
                          </VStack>
                        </If>
                      </HStack>
                      <If test={state.editing_message_id == msg.id}>
                        <Form action="/chat/messages/edit" method="post">
                          <TextInput name="id" type="hidden" value={msg.id} />
                          <HStack spacing=6>
                            <TextInput name="body" value={msg.body} grow=1 />
                            <Button text="Save" />
                          </HStack>
                        </Form>
                        <Form action="/chat/messages/edit/cancel" method="post">
                          <Button text="Cancel" />
                        </Form>
                      </If>
                      <Else>
                        <If test={msg.body != ""}>
                          <Text value={msg.body} />
                        </If>
                        <If test={msg.image_url != ""}>
                          <Image
                            src={msg.image_url}
                            href={msg.image_href}
                            alt="picture"
                            objectFit="contain"
                            maxWidth=320
                            maxHeight=220
                            cursor="pointer"
                          />
                        </If>
                      </Else>
                    </VStack>
                  </For>
                </If>
              </For>
            </If>
          </VStack>
          <VStack spacing=6>
            <Form action="/messages" method="post" spacing=6>
              <HStack class="puppychat-composer" spacing=6>
                <TextInput name="active_kind" type="hidden" value={state.active_kind} />
                <TextInput name="active_id" type="hidden" value={state.active_id} />
                <TextInput
                  name="body"
                  placeholder="Write a message"
                  grow=1
                />
                <Button text="Send" />
              </HStack>
            </Form>
            <Form action="/chat/attachments/open" method="post"><Button text="Attach image" /></Form>
          </VStack>
        </VStack>
      </HStack>
      <Modal open={state.show_attach_menu}>
        <VStack class="puppychat-upload-modal" padding=16 spacing=10 width=360 backgroundColor="#ffffff" border="1px solid #d9d9d9">
          <Text value="Upload image" />
          <Form action="/chat/attachments" method="post">
            <FolderPicker name="image_url" />
            <HStack class="puppychat-upload-submit-row" spacing=8>
              <Button text="Send image" />
            </HStack>
          </Form>
          <HStack class="puppychat-upload-cancel-row" spacing=8>
            <Form action="/chat/attachments/cancel" method="post"><Button text="Close" /></Form>
          </HStack>
        </VStack>
      </Modal>
      <Modal open={state.show_create_channel}>
        <VStack class="puppychat-create-channel-modal" padding=16 spacing=10 width=360 backgroundColor="#ffffff" border="1px solid #d9d9d9">
          <Text value="Create channel" />
          <Form action="/chat/channels" method="post">
            <TextInput name="name" placeholder="Channel name" />
            <HStack class="puppychat-create-submit-row" spacing=8>
              <Button text="Create" />
            </HStack>
          </Form>
          <HStack class="puppychat-create-cancel-row" spacing=8>
            <Form action="/chat/channels/cancel" method="post"><Button text="Cancel" /></Form>
          </HStack>
        </VStack>
      </Modal>
      <Modal open={state.show_image_modal}>
        <VStack
          padding=12
          spacing=8
          backgroundColor="#ffffff"
          border="1px solid #d9d9d9"
        >
          <Image
            src={state.selected_image_url}
            alt="full image"
            objectFit="contain"
          />
          <Form action="/chat/images/close" method="post"><Button text="Close" /></Form>
        </VStack>
      </Modal>
    </Else>
  </Case>
</Switch>
